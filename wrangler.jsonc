{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "academia-yamilet",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./yamilet-perez-site-v2-verde-github",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "stream": {
    "binding": "STREAM"
  },
  "vars": {
    "ACADEMY_WORKSPACE_SLUG": "yamilet-mes"
  }
}
